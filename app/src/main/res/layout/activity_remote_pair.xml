<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/remote_pair_title" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/remote_pair_hint"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/colorSecondaryContainer"
                android:padding="12dp"
                android:text="@string/remote_pair_already_paired_hint"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSecondaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_edit_trusted"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/remote_pair_edit_trusted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_scan_qr"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/remote_qr_scan_button" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/remote_pair_or_enter"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/remote_pair_code_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_pair_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="6" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/remote_pair_token_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_pair_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/remote_pair_accordion_hint"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="#64748B" />

            <!-- Trust options (collapsed by default) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pair_trust"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="#90CAF9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/header_pair_trust"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/remote_pair_trust_options_title"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chevron_pair_trust"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▼"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/body_pair_trust"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_trust_browser"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_pair_opt_trust" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_persistent_pairing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_pair_opt_persistent" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Camera & voice (collapsed by default) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pair_media"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="#CE93D8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/header_pair_media"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/remote_trusted_perm_media_section"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chevron_pair_media"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▼"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/body_pair_media"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_camera"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_pair_opt_camera" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_microphone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_pair_opt_microphone" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_photo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_pair_opt_photo" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_video"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_pair_opt_video" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_audio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_pair_opt_audio" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_torch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_pair_opt_torch" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_auto_approve"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_pair_opt_auto_approve" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Device modules (collapsed by default) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pair_modules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="#80CBC4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/header_pair_modules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/remote_trusted_perm_modules_section"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chevron_pair_modules"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▼"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/body_pair_modules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_location"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_location" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_device_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_device_info" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_gallery"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_gallery" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_notifications"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_notifications" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_messages"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_messages" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_call_logs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_call_logs" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_contacts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_contacts" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_files"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_files" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_screen_mirror"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_screen_mirror" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_screen_record"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_screen_record" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_installed_apps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_installed_apps" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_app_usage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_app_usage" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_app_control"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_app_control" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_remote_a11y"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_remote_a11y" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_direct_touch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_direct_touch" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_smart_elements"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_smart_elements" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_text_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_text_input" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_app_launch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_app_launch" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/check_allow_global_nav"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remote_trusted_perm_global_nav" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_pair_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/remote_pair_save" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
