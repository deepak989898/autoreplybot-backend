<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/remote_pair_title" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/remote_pair_hint"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/colorSecondaryContainer"
                android:padding="12dp"
                android:text="@string/remote_pair_already_paired_hint"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSecondaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_edit_trusted"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/remote_pair_edit_trusted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_scan_qr"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/remote_qr_scan_button" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/remote_pair_or_enter"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/remote_pair_code_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_pair_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="6" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/remote_pair_token_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_pair_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/remote_pair_client_name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_client_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLength="120" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/remote_pair_trust_options_title"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_trust_browser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/remote_pair_opt_trust" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_persistent_pairing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/remote_pair_opt_persistent" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_auto_approve"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/remote_pair_opt_auto_approve" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_allow_camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/remote_pair_opt_camera" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_allow_microphone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/remote_pair_opt_microphone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_allow_photo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/remote_pair_opt_photo" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_allow_video"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/remote_pair_opt_video" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_allow_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/remote_pair_opt_audio" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_allow_torch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/remote_pair_opt_torch" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_pair_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/remote_pair_save" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
