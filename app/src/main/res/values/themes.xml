<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.AutoReplyBot" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Material 3 / androidx.activity may enable edge-to-edge; turn off so bars are opaque -->
        <item name="enableEdgeToEdge">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/app_status_bar</item>
        <item name="android:navigationBarColor">@color/app_navigation_bar</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AutoReplyBot" parent="Base.Theme.AutoReplyBot" />

    <!-- Invisible trampoline for FCM tap-to-start (no Active Session UI). -->
    <style name="Theme.AutoReplyBot.Transparent" parent="Theme.AutoReplyBot">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Status bar = light strip + dark icons (same idea as main). Blue gradient is only below the bar. -->
    <style name="Theme.AutoReplyBot.FacebookPosting" parent="Theme.AutoReplyBot">
        <item name="enableEdgeToEdge">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/fb_posting_screen_bg</item>
        <item name="android:navigationBarColor">@color/fb_posting_screen_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AutoReplyBot.Splash" parent="Theme.AutoReplyBot">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="colorControlActivated">@color/brand_blue</item>
    </style>

    <style name="Theme.AutoReplyBot.Welcome" parent="Theme.AutoReplyBot">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="LoanProfileRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawableEnd">@drawable/ic_loan_chevron</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/welcome_title</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>