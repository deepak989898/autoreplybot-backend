rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validImage() {
      return request.resource.size > 0
          && request.resource.size <= 10 * 1024 * 1024
          && request.resource.contentType in [
            'image/png', 'image/jpeg', 'image/webp'
          ];
    }

    match /facebook_posts/{userId}/{fileName} {
      // Firebase download-token URLs and Admin SDK signed URLs remain usable by Meta.
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validImage();
      allow delete: if isOwner(userId);
    }

    function validRemoteMedia() {
      return request.resource.size > 0
          && request.resource.size <= 500 * 1024 * 1024
          && request.resource.contentType.matches('image/.*|video/.*|audio/.*');
    }

    match /remote_media/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validRemoteMedia();
      allow delete: if isOwner(userId);
    }

    function validPrivateTransfer() {
      return request.resource.size > 0
          && request.resource.size <= 100 * 1024 * 1024
          && request.resource.contentType.matches('image/.*|video/.*|audio/.*|application/pdf|text/.*|application/zip|application/octet-stream');
    }

    match /users/{userId}/devices/{deviceId}/gallery-transfers/{transferId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validPrivateTransfer();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/devices/{deviceId}/file-transfers/{transferId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validPrivateTransfer();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/devices/{deviceId}/call-recordings/{recordingId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validPrivateTransfer();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/devices/{deviceId}/exports/{exportId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
          && request.resource.size > 0
          && request.resource.size <= 20 * 1024 * 1024
          && request.resource.contentType.matches('application/json|text/csv|text/plain');
      allow delete: if isOwner(userId);
    }

    match /autoreplybot.apk {
      // Public read so install links / signed downloads remain simple; write stays locked down.
      allow read: if true;
      allow write: if false;
    }

    function validSupportMedia() {
      return request.resource.size > 0
          && (
            (
              request.resource.size <= 10 * 1024 * 1024
              && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp']
            )
            || (
              request.resource.size <= 50 * 1024 * 1024
              && request.resource.contentType in ['video/mp4', 'video/webm']
            )
          );
    }

    // Website Help/Support chat attachments (user ↔ Platform Admin).
    match /support_chat/{userId}/{messageId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validSupportMedia();
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}