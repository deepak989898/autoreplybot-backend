# Firebase Admin (pick ONE approach)
# 1) Path to service account JSON file (local dev)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# 2) Full JSON as one line (Vercel env var — paste mini single-line JSON)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional: explicit bucket if not default project.appspot.com
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Public Firebase Web config (for hosted dashboard in /public)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=

# Meta app id used by web Facebook SDK
FACEBOOK_APP_ID=

# OpenAI (same as Android local.properties conceptually)
OPENAI_API_KEY=sk-...

# Cron: Vercel sends Authorization: Bearer <this> when invoking cron jobs (configure in Vercel dashboard or use CRON_SECRET)
CRON_SECRET=generate-a-long-random-string

# Default IANA timezone when schedule doc has no scheduleTimezone (match user phones later by storing timezone in Firestore)
DEFAULT_SCHEDULE_TIMEZONE=UTC
