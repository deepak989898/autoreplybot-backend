{
  "regions": ["iad1"],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-post",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/pair/:action",
      "destination": "/api/pair-router?action=:action"
    },
    {
      "source": "/api/device/session/:op",
      "destination": "/api/device-router?slug=session/:op"
    },
    {
      "source": "/api/device/:path*",
      "destination": "/api/device-router?slug=:path*"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/public/$1"
    }
  ]
}
