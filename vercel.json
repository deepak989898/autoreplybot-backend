{
  "regions": ["iad1"],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-post",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/device/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/device/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/device/" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/pair/:action",
      "destination": "/api/pair-router?action=:action"
    },
    {
      "source": "/api/device/session/:op",
      "destination": "/api/device-router?slug=session/:op"
    },
    {
      "source": "/api/device/:path*",
      "destination": "/api/device-router?slug=:path*"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/public/$1"
    }
  ]
}
